# Identificação do projeto; não coloque credenciais ou chaves neste arquivo.
GOOGLE_CLOUD_PROJECT=seu-id-de-projeto
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_API_VERSION=v1
VERTEX_MODEL=gemini-3.5-flash

# Limites operacionais conservadores para transformação estruturada.
LEIAUT_BLOCK_INPUT_TOKENS=5000
LEIAUT_TIMEOUT_MS=180000
LEIAUT_THINKING_BUDGET=0
